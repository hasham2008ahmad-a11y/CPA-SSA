{
  "name": "YorkU ACE",
  "version": 1,
  "color": {
    "themes": [
      { "id": "light", "name": "Light" },
      { "id": "dark", "name": "Dark" }
    ],
    "tokens": [
      { "name": "surface-page", "value": { "light": "#f6f8fb", "dark": "#0a1626" }, "usage": "Page background." },
      { "name": "surface-card", "value": { "light": "#ffffff", "dark": "#10203a" }, "usage": "Cards, panels, nav bars." },
      { "name": "surface-sunken", "value": { "light": "#eaf0f7", "dark": "#0d1c30" }, "usage": "Table stripes, input fields, code blocks." },
      { "name": "ink", "value": { "light": "#0a1f33", "dark": "#eaf1f8" }, "usage": "Primary text on surface-page and surface-card." },
      { "name": "ink-muted", "value": { "light": "#44536a", "dark": "#a9bcd1" }, "usage": "Secondary text, captions, placeholder copy." },
      { "name": "border", "value": { "light": "#d7e1ec", "dark": "#1f3350" }, "usage": "Dividers, input borders, card outlines." },
      { "name": "brand-primary", "value": { "light": "#0f2b4c", "dark": "#4fa8e0" }, "usage": "YorkU ACE's chapter colour — headers, links, primary buttons, nav." },
      { "name": "brand-primary-ink", "value": { "light": "#ffffff", "dark": "#0a1626" }, "usage": "Text and icons placed on top of brand-primary fills." },
      { "name": "brand-secondary", "value": { "light": "#2c74b3", "dark": "#7fc2ef" }, "usage": "The chapter's light-blue accent — secondary actions, highlights, links on dark fills." },
      { "name": "brand-secondary-tint", "value": { "light": "#eaf4fc", "dark": "#122b42" }, "usage": "Soft fills: hover states, selected rows, default badges." },
      { "name": "national-accent", "value": { "light": "#c8102e", "dark": "#e8475f" }, "usage": "ACE Canada red — reserved for explicitly national-affiliated moments (the ACE Canada mark, national case-competition promos). Not a general accent." },
      { "name": "national-accent-ink", "value": { "light": "#ffffff", "dark": "#1a0508" }, "usage": "Text and icons on top of national-accent fills." },
      { "name": "success", "value": { "light": "#1e7a46", "dark": "#52c98a" }, "usage": "Confirmed, open, accepted statuses." },
      { "name": "warning", "value": { "light": "#9a6400", "dark": "#e8b33d" }, "usage": "Deadlines, waitlist, limited-capacity statuses." },
      { "name": "danger", "value": { "light": "#b54708", "dark": "#f0a15c" }, "usage": "Errors and destructive actions. Kept warm-orange, distinct in hue from national-accent so the two are never mistaken for each other." }
    ]
  },
  "type": {
    "fonts": [],
    "families": {
      "display": "'Archivo', 'Inter', system-ui, sans-serif",
      "sans": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'IBM Plex Mono', 'SFMono-Regular', Menlo, monospace"
    },
    "groups": [
      {
        "name": "Display",
        "family": "display",
        "styles": [
          { "name": "h1", "fontSize": "40px", "lineHeight": "48px", "fontWeight": 700, "letterSpacing": "-0.01em", "usage": "Page and section heroes." },
          { "name": "h2", "fontSize": "28px", "lineHeight": "36px", "fontWeight": 700, "usage": "Section headings." },
          { "name": "h3", "fontSize": "22px", "lineHeight": "30px", "fontWeight": 600, "usage": "Card and subsection headings." },
          { "name": "h4", "fontSize": "18px", "lineHeight": "26px", "fontWeight": 600, "usage": "Minor headings, dialog titles." }
        ]
      },
      {
        "name": "Text",
        "family": "sans",
        "styles": [
          { "name": "body", "fontSize": "16px", "lineHeight": "26px", "fontWeight": 400, "usage": "Default running text." },
          { "name": "body-sm", "fontSize": "14px", "lineHeight": "22px", "fontWeight": 400, "usage": "Secondary text, form helper text." },
          { "name": "caption", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 500, "letterSpacing": "0.02em", "usage": "Timestamps, metadata, fine print." }
        ]
      },
      {
        "name": "Data",
        "family": "mono",
        "styles": [
          { "name": "stat", "fontSize": "34px", "lineHeight": "38px", "fontWeight": 600, "usage": "Headline figures — membership counts, case-comp results, dollars raised." },
          { "name": "label", "fontSize": "11px", "lineHeight": "16px", "fontWeight": 600, "letterSpacing": "0.08em", "usage": "Uppercase labels above tabular data." }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      { "name": "space-1", "value": "4px", "usage": "Icon-to-label gaps." },
      { "name": "space-2", "value": "8px", "usage": "Tight stacks, button icon gaps." },
      { "name": "space-3", "value": "12px", "usage": "Compact list items." },
      { "name": "space-4", "value": "16px", "usage": "Card padding, base gutter." },
      { "name": "space-5", "value": "24px", "usage": "Gaps between cards and form fields." },
      { "name": "space-6", "value": "32px", "usage": "Gaps between major components." },
      { "name": "space-7", "value": "48px", "usage": "Section padding." },
      { "name": "space-8", "value": "64px", "usage": "Page-level rhythm between sections." }
    ]
  },
  "radius": {
    "tokens": [
      { "name": "radius-sm", "value": "6px", "usage": "Inputs, tags, small chips." },
      { "name": "radius-md", "value": "10px", "usage": "Buttons, dropdowns." },
      { "name": "radius-lg", "value": "16px", "usage": "Cards, modals, images." },
      { "name": "radius-pill", "value": "999px", "usage": "Badges, pill buttons, avatars." }
    ]
  }
}
